# Application Environment
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./privacy_gateway.db

# Gateway Security & Secrets (Change in Production)
GATEWAY_SECRET_KEY=replace-with-a-random-32-character-secret-key
GATEWAY_ADMIN_TOKEN=admin-secret-token-demo

# Privacy Defaults
PII_DETECTION_ENABLED=true
PII_DEFAULT_MODE=redact
PII_MIN_CONFIDENCE=0.70
PII_RESTORE_ENABLED=false
PII_RESPONSE_SCAN_ENABLED=true

# Audit Logging & Telemetry (No raw prompts or PII logged)
LOG_LEVEL=INFO
AUDIT_LOG_ENABLED=true
AUDIT_LOG_CONTENT=false

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Upstream Providers (Server-side only)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434

UPSTREAM_TIMEOUT_SECONDS=60
MAX_REQUEST_BODY_BYTES=1048576
